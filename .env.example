#!/usr/bin/env zsh
APP_ENV=development
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=8080

DB_USER=sam
DB_NAME=jobradar
DB_URL=postgres://sam:password@localhost:5432/jobradar?sslmode=disable
DB_PASSWORD=password

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

ONBOARDING_TTL=10m
SESSION_TTL=240h
SCRAPE_INTERVAL=6h

REDIS_ADDR=localhost:6379

# Generate once: openssl rand -base64 32. Keep it stable and back it up securely.
ENCRYPTION_KEY=
AI_ENRICHMENT_ENABLED=false
AI_MATCH_THRESHOLD=60
FRONTEND_DIST=frontend/dist

# Only this address may sign in when set. Recommended for a personal deployment.
PERSONAL_EMAIL=

# Optional Adzuna. 12-hour polling; at most 5 searches x 3 pages per run.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_QUERIES=Go Developer,Backend Engineer
ADZUNA_LOCATION=
ADZUNA_PAGES=1
REMOTEOK_ENABLED=true
# Comma-separated actual board slugs, not company website URLs.
GREENHOUSE_BOARDS=

# Disabled until configured. No arbitrary recipients or mass-email endpoint.
DIGEST_ENABLED=false
DIGEST_RECIPIENT=
DIGEST_TIMEZONE=America/New_York
DIGEST_HOUR=8
DIGEST_MIN_SCORE=50
DIGEST_MAX_JOBS=10
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
# Optional alternative provider; needs contacts.readonly + conversations/message.write.
GHL_API_KEY=
GHL_CONTACT_ID=
