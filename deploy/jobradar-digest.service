[Unit]
Description=Jobradar personal morning digest
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Code/projects/jobradar
ExecStart=%h/Code/projects/jobradar/bin/jobradar --digest-worker
Restart=always
RestartSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
